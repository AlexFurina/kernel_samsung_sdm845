#
#
# Galaxy S9 Plus Japan (SSC-03K,SCV39) Config
#

# CONFIG_SEC_STARQLTE_PROJECT is not set
CONFIG_SEC_STAR2QLTE_PROJECT=y
CONFIG_MACH_STAR2QLTE_KDI=y
# CONFIG_NFC_PN547 is not set
# CONFIG_NFC_PN547_ESE_SUPPORT is not set
CONFIG_SEC_NFC=y
# CONFIG_ESE_P3_LSI is not set
# CONFIG_ESE_SECURE is not set
CONFIG_ESE_SPI_GPIO_START=-1
CONFIG_ESE_SPI_GPIO_END=-1
CONFIG_ESE_SPI_NUMBER=99
CONFIG_ISDBT=y
CONFIG_ISDBT_FC8350_SPI=y
CONFIG_FLASH_CURRENT_JAPAN=y
CONFIG_CS100_JPNCONCEPT=y
CONFIG_MMC_CPRM=y
# CONFIG_TARGET_LOCALE_CHN is not set
# CONFIG_ENABLE_100MA_CHARGING_BEFORE_USB_CONFIGURED is not set
# CONFIG_SAMSUNG_OIS_RUMBA_S4 is not set
CONFIG_SAMSUNG_OIS_RUMBA_S6=y
CONFIG_SAMSUNG_REAR_DUAL=y
CONFIG_SAMSUNG_MULTI_CAMERA=y
CONFIG_PANEL_S6E3HA6_AMS622MR01_WQHD=y
# CONFIG_PANEL_S6E3HA6_AMB577MQ01_WQHD is not set
CONFIG_PANEL_S6E3HA8_AMB622NP01_WQHD=y
# CONFIG_PANEL_S6E3HA8_AMB577PX01_WQHD is not set
